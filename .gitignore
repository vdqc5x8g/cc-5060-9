# solo-manager GitHub sync ignores
node_modules/
vendor/
dist/
build/
.next/
.nuxt/
.output/
coverage/
.turbo/
.cache/
.parcel-cache/
.vite/
target/
.gradle/
.venv/
venv/
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.DS_Store
*.log
.env
.env.*

# nmfsep local artifacts
.pylibs/
runs/
artifacts/
data/external/

# Keep the documented demo outputs and recording eligible for delivery.
!/data/external/
/data/external/*
!/data/external/beethoven_op101_mvt1.ogg

!/runs/
/runs/*
!/runs/demo/
!/runs/unknown/
!/runs/sweep/
!/runs/unknown_sweep/
/runs/demo/*
!/runs/demo/separable/
!/runs/demo/ambiguous/
!/runs/demo/separable_anchored/
!/runs/demo/ambiguous_twins_anchored/
!/runs/demo/separable_ground_truth.npz
!/runs/demo/ambiguous_ground_truth.npz
!/runs/demo/summary.json
/runs/unknown/*
!/runs/unknown/beethoven_op101/
!/runs/unknown/beethoven_op101_k9/
/runs/**/grouped/
/runs/**/solo/
/runs/**/magnitude.npy
/runs/**/mixture_stft.npy

!/artifacts/
/artifacts/*
!/artifacts/figures/

# Local NMF jobs started from the browser and generated automation output.
/runs/**/nmf_numpy_[0-9]*/
/runs/**/nmf_scipy_[0-9]*/
/runs/**/activations_automated.npy
